{
    "compilerOptions": {
        "strict": true,
        "noImplicitAny": true,
        "esModuleInterop": true,
        "strictNullChecks": true,
        "target": "ES2022",
        "module": "CommonJS",
        "declaration": true,
        "isolatedModules": true,
        "outDir": "./dist/",
        "rootDir": "./src/"
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules"
    ]
}